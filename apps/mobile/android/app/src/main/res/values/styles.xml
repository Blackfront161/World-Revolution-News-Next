<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/wrn_native_violet</item>
        <item name="colorPrimaryDark">@color/wrn_native_canvas</item>
        <item name="colorAccent">@color/wrn_native_red</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/wrn_native_canvas</item>
        <item name="android:statusBarColor">@color/wrn_native_canvas</item>
        <item name="android:navigationBarColor">@color/wrn_native_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/wrn_native_red</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/wrn_native_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/wrn_native_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
